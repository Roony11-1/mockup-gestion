---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MobileFrame from '../components/MobileFrame.astro';
import BathroomsModule from '../components/BathroomsModule.astro';
import TeacherReviews from '../components/TeacherReviews.astro';
import StudentReviews from '../components/StudentReviews.astro';
---
<Layout title="CampusConnect+ | Dashboard">
  <Navbar />

  <main class="mx-auto max-w-6xl px-4 py-6">

    <!-- ============ VISTA ESTUDIANTE (móvil con tabs) ============ -->
    <div id="view-student" class="hidden">
      <MobileFrame>
        <div class="p-4">
          <h1 class="mb-1 text-lg font-bold">Hola, Estudiante</h1>
          <p class="mb-3 text-xs text-slate-500">App móvil · CampusConnect+</p>

          <!-- Tab bar -->
          <div id="student-tabs" class="mb-4 flex rounded-xl bg-slate-100 p-1">
            <button data-tab="tab-banos" class="student-tab flex-1 rounded-lg px-2 py-2 text-[11px] font-bold text-blue-700 shadow-sm bg-white">
              🚻 Baños
            </button>
            <button data-tab="tab-profes" class="student-tab flex-1 rounded-lg px-2 py-2 text-[11px] font-bold text-slate-400">
              👨‍🏫 Profes
            </button>
            <button data-tab="tab-companeros" class="student-tab flex-1 rounded-lg px-2 py-2 text-[11px] font-bold text-slate-400">
              🧑‍🤝‍🧑 Compañeros
            </button>
          </div>

          <!-- Panel: Baños -->
          <div id="tab-banos" class="student-panel">
            <BathroomsModule variant="cards-student" title="Baños de la sede" description="Ubicación, horario de aseo y estado en tiempo real." />
          </div>

          <!-- Panel: Profesores -->
          <div id="tab-profes" class="student-panel hidden">
            <TeacherReviews />
          </div>

          <!-- Panel: Compañeros -->
          <div id="tab-companeros" class="student-panel hidden">
            <StudentReviews />
          </div>

          <button data-reset class="mt-4 w-full rounded-lg border border-slate-300 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-50">
            Restablecer datos demo
          </button>
        </div>
      </MobileFrame>
    </div>

    <!-- ============ VISTA STAFF ASEO (responsive: cards móvil + table escritorio) ============ -->
    <div id="view-staff" class="hidden">
      <div class="mx-auto grid max-w-4xl gap-4">
        <div>
          <h1 class="text-xl font-bold">Panel · Personal de Aseo / Sede</h1>
          <p class="text-sm text-slate-500">Cambia el estado de los baños en tiempo real. No tienes acceso a reseñas (privacidad).</p>
        </div>

        <!-- Tab bar móvil staff -->
        <div id="staff-tabs" class="flex rounded-xl bg-slate-100 p-1 sm:hidden">
          <button data-tab="tab-staff-banos" class="staff-tab flex-1 rounded-lg px-3 py-2 text-xs font-bold text-emerald-700 shadow-sm bg-white">
            🚻 Baños
          </button>
          <button data-tab="tab-staff-info" class="staff-tab flex-1 rounded-lg px-3 py-2 text-xs font-bold text-slate-400">
            ℹ️ Privacidad
          </button>
        </div>

        <!-- Panel: Baños (cards en móvil, tabla en desktop) -->
        <div id="tab-staff-banos" class="staff-panel">
          <BathroomsModule variant="table-staff" title="Mantenedor de baños" description="Los cambios se guardan en localStorage y se ven al acto como estudiante." />
        </div>

        <!-- Panel: Info privacidad (solo visible en móvil vía tab) -->
        <div id="tab-staff-info" class="staff-panel hidden">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
            <p class="mb-1 font-bold">🔒 Privacidad</p>
            <p>Reseñas de profesores y estudiantes ocultas para tu rol por regla de privacidad del proyecto.</p>
          </div>
        </div>

        <!-- Siempre visible en desktop -->
        <div class="hidden sm:block">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
            <p class="font-bold">🔒 Privacidad</p>
            <p>Reseñas de profesores y estudiantes ocultas para tu rol por regla de privacidad del proyecto.</p>
          </div>
        </div>

        <button data-reset class="w-full rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-white sm:w-auto">
          Restablecer datos demo
        </button>
      </div>
    </div>

    <!-- ============ VISTA DOCENTE (móvil con tabs) ============ -->
    <div id="view-teacher" class="hidden">
      <MobileFrame>
        <div class="p-4">
          <h1 class="mb-1 text-lg font-bold">Docente</h1>
          <p class="mb-3 text-xs text-slate-500">Estado de baños · CampusConnect+</p>

          <!-- Tab bar -->
          <div id="teacher-tabs" class="mb-4 flex rounded-xl bg-slate-100 p-1">
            <button data-tab="tab-teach-banos" class="teach-tab flex-1 rounded-lg px-3 py-2 text-xs font-bold text-amber-700 shadow-sm bg-white">
              🚻 Baños
            </button>
            <button data-tab="tab-teach-info" class="teach-tab flex-1 rounded-lg px-3 py-2 text-xs font-bold text-slate-400">
              🔒 Privacidad
            </button>
          </div>

          <div id="tab-teach-banos" class="teach-panel">
            <BathroomsModule variant="cards-teacher" title="Estado de baños" description="Solo lectura para tu rol." />
          </div>

          <div id="tab-teach-info" class="teach-panel hidden">
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
              <p class="mb-1 font-bold">🔒 Acceso restringido por privacidad</p>
              <p>Las opiniones sobre docentes y las referencias entre estudiantes no son visibles para cuentas de profesor ni externas.</p>
            </div>
          </div>
        </div>
      </MobileFrame>
    </div>

  </main>

  <script>
    import {
      SESSION_KEY,
      BATHROOM_STATUSES,
      loadData,
      saveData,
      resetData,
    } from '../lib/mockData.js';

    // --- Tabs genéricos ---
    function setupTabs(barSelector, tabSelector, panelSelector) {
      const buttons = document.querySelectorAll(tabSelector);
      const panels = document.querySelectorAll(panelSelector);
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-tab');
          panels.forEach((p) => p.classList.add('hidden'));
          buttons.forEach((b) => {
            b.classList.remove('shadow-sm', 'bg-white');
            // restore inactive color
            b.classList.add('text-slate-400');
          });
          const target = document.getElementById(targetId);
          if (target) target.classList.remove('hidden');
          btn.classList.add('shadow-sm', 'bg-white');
          btn.classList.remove('text-slate-400');
        });
      });
    }

    setupTabs('#student-tabs', '.student-tab', '.student-panel');
    setupTabs('#staff-tabs', '.staff-tab', '.staff-panel');
    setupTabs('#teacher-tabs', '.teach-tab', '.teach-panel');

    // --- Sesión + rol ---
    const views = {
      student: document.getElementById('view-student'),
      staff: document.getElementById('view-staff'),
      teacher: document.getElementById('view-teacher'),
    };

    let session = null;
    try {
      session = JSON.parse(sessionStorage.getItem(SESSION_KEY) ?? 'null');
    } catch { session = null; }

    if (!session || !views[session.role]) {
      window.location.href = '/';
    } else {
      const role = session.role;
      Object.values(views).forEach((v) => v?.classList.add('hidden'));
      views[role]?.classList.remove('hidden');

      let db = loadData();

      // --- Helpers ---
      const badge = (status) =>
        status === 'Disponible'
          ? 'bg-emerald-100 text-emerald-800'
          : status === 'En limpieza'
            ? 'bg-amber-100 text-amber-800'
            : 'bg-red-100 text-red-800';

      const stars = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);

      // --- Baños: cards ---
      function cardBathroom(b) {
        const wrap = document.createElement('div');
        wrap.className = 'rounded-xl border border-slate-200 p-3';
        const top = document.createElement('div');
        top.className = 'flex items-center justify-between gap-2';
        const loc = document.createElement('p');
        loc.className = 'text-sm font-bold';
        loc.textContent = b.floor;
        const st = document.createElement('span');
        st.className = 'rounded-full px-2 py-0.5 text-[11px] font-bold ' + badge(b.status);
        st.textContent = b.status;
        top.append(loc, st);
        const sch = document.createElement('p');
        sch.className = 'mt-1 text-xs text-slate-500';
        sch.textContent = 'Aseo: ' + b.schedule;
        wrap.append(top, sch);
        return wrap;
      }

      function renderStudentBathrooms() {
        const list = document.getElementById('bathrooms-student-list');
        if (!list) return;
        list.innerHTML = '';
        db.bathrooms.forEach((b) => list.appendChild(cardBathroom(b)));
      }

      function renderTeacherBathrooms() {
        const list = document.getElementById('bathrooms-teacher-list');
        if (!list) return;
        list.innerHTML = '';
        db.bathrooms.forEach((b) => list.appendChild(cardBathroom(b)));
      }

      // --- Baños: tabla staff (escritorio) ---
      function renderStaffTable() {
        const tbody = document.getElementById('bathrooms-staff-tbody');
        if (!tbody) return;
        tbody.innerHTML = '';
        db.bathrooms.forEach((b) => {
          const tr = document.createElement('tr');
          tr.className = 'border-b border-slate-100';

          const tdLoc = document.createElement('td');
          tdLoc.className = 'py-2 pr-2 font-semibold';
          tdLoc.textContent = b.floor;

          const tdSch = document.createElement('td');
          tdSch.className = 'py-2 pr-2 text-slate-500';
          tdSch.textContent = b.schedule;

          const tdSt = document.createElement('td');
          tdSt.className = 'py-2 pr-2';
          const pill = document.createElement('span');
          pill.className = 'rounded-full px-2 py-0.5 text-xs font-bold ' + badge(b.status);
          pill.textContent = b.status;
          tdSt.appendChild(pill);

          const tdSel = document.createElement('td');
          tdSel.className = 'py-2';
          const sel = document.createElement('select');
          sel.className = 'rounded-lg border border-slate-300 px-2 py-1.5 text-sm';
          sel.dataset.id = String(b.id);
          BATHROOM_STATUSES.forEach((s) => {
            const o = document.createElement('option');
            o.value = s; o.textContent = s;
            if (s === b.status) o.selected = true;
            sel.appendChild(o);
          });
          sel.addEventListener('change', () => {
            db = loadData();
            const item = db.bathrooms.find((x) => x.id === Number(sel.dataset.id));
            if (item) { item.status = sel.value; saveData(db); renderStaffTable(); renderStaffCards(); }
          });
          tdSel.appendChild(sel);
          tr.append(tdLoc, tdSch, tdSt, tdSel);
          tbody.appendChild(tr);
        });
      }

      // --- Baños: cards staff (móvil) ---
      function renderStaffCards() {
        const list = document.getElementById('bathrooms-staff-cards');
        if (!list) return;
        list.innerHTML = '';
        db.bathrooms.forEach((b) => {
          const wrap = document.createElement('div');
          wrap.className = 'rounded-xl border border-slate-200 p-3';

          const top = document.createElement('div');
          top.className = 'flex items-center justify-between gap-2';
          const loc = document.createElement('p');
          loc.className = 'text-sm font-bold';
          loc.textContent = b.floor;
          const pill = document.createElement('span');
          pill.className = 'rounded-full px-2 py-0.5 text-[11px] font-bold ' + badge(b.status);
          pill.textContent = b.status;
          top.append(loc, pill);

          const sch = document.createElement('p');
          sch.className = 'mt-1 text-xs text-slate-500';
          sch.textContent = 'Aseo: ' + b.schedule;

          const sel = document.createElement('select');
          sel.className = 'mt-2 w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm';
          sel.dataset.id = String(b.id);
          BATHROOM_STATUSES.forEach((s) => {
            const o = document.createElement('option');
            o.value = s; o.textContent = s;
            if (s === b.status) o.selected = true;
            sel.appendChild(o);
          });
          sel.addEventListener('change', () => {
            db = loadData();
            const item = db.bathrooms.find((x) => x.id === Number(sel.dataset.id));
            if (item) { item.status = sel.value; saveData(db); renderStaffCards(); renderStaffTable(); }
          });

          wrap.append(top, sch, sel);
          list.appendChild(wrap);
        });
      }

      // --- Reseñas: helpers ---
      function reviewCard(title, rating, comment) {
        const d = document.createElement('div');
        d.className = 'rounded-xl border border-slate-200 p-3';
        const t = document.createElement('p');
        t.className = 'text-sm font-bold';
        t.textContent = title;
        const r = document.createElement('p');
        r.className = 'text-xs font-semibold text-amber-600';
        r.textContent = stars(Number(rating)) + ` (${rating}/5)`;
        const c = document.createElement('p');
        c.className = 'mt-1 text-sm text-slate-600';
        c.textContent = comment;
        d.append(t, r, c);
        return d;
      }

      function renderReviews() {
        const tList = document.getElementById('teacher-reviews-list');
        const sList = document.getElementById('student-reviews-list');
        if (tList) {
          tList.innerHTML = '';
          if (!db.teacherReviews.length) tList.innerHTML = '<p class="text-xs text-slate-400">Sin reseñas aún. ¡Agrega la primera!</p>';
          db.teacherReviews.forEach((r) => tList.appendChild(reviewCard(r.teacher, r.rating, r.comment)));
        }
        if (sList) {
          sList.innerHTML = '';
          if (!db.studentReviews.length) sList.innerHTML = '<p class="text-xs text-slate-400">Sin reseñas aún. ¡Agrega la primera!</p>';
          db.studentReviews.forEach((r) => sList.appendChild(reviewCard(r.student, r.rating, r.comment)));
        }
      }

      // --- Init por rol ---
      if (role === 'student') {
        renderStudentBathrooms();
        renderReviews();

        document.getElementById('teacher-review-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(e.target);
          const teacher = String(fd.get('teacher') ?? '').trim();
          const rating = Number(fd.get('rating'));
          const comment = String(fd.get('comment') ?? '').trim();
          if (!teacher || !comment || !(rating >= 1 && rating <= 5)) return;
          db = loadData();
          db.teacherReviews.unshift({ id: Date.now(), teacher, rating, comment });
          saveData(db);
          renderReviews();
          e.target.reset();
        });

        document.getElementById('student-review-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const fd = new FormData(e.target);
          const student = String(fd.get('student') ?? '').trim();
          const rating = Number(fd.get('rating'));
          const comment = String(fd.get('comment') ?? '').trim();
          if (!student || !comment || !(rating >= 1 && rating <= 5)) return;
          db = loadData();
          db.studentReviews.unshift({ id: Date.now(), student, rating, comment });
          saveData(db);
          renderReviews();
          e.target.reset();
        });
      } else {
        // PRIVACIDAD: elimina reseñas del DOM
        document.querySelectorAll('[id$="-reviews-panel"]').forEach((el) => el.remove());
        document.querySelectorAll('[id$="-review-form"]').forEach((el) => el.closest('div')?.remove());

        if (role === 'staff') {
          renderStaffTable();
          renderStaffCards();
        }
        if (role === 'teacher') {
          renderTeacherBathrooms();
        }
      }

      // --- Reset demo ---
      document.querySelectorAll('[data-reset]').forEach((b) =>
        b.addEventListener('click', () => {
          db = resetData();
          if (role === 'student') { renderStudentBathrooms(); renderReviews(); }
          if (role === 'staff') { renderStaffTable(); renderStaffCards(); }
          if (role === 'teacher') renderTeacherBathrooms();
        }),
      );
    }
  </script>
</Layout>
