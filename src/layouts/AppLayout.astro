---
import Layout from './Layout.astro';
import { AppNav } from '../components/layout/AppNav';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description, currentPath } = Astro.props;
---
<Layout title={title} description={description}>
  <a
    href="#contenido-principal"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:border focus:border-line focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink focus:shadow-[var(--shadow-md)]"
  >
    Saltar al contenido principal
  </a>

  <AppNav client:load currentPath={currentPath} />

  <div class="lg:pl-72">
    <main
      id="contenido-principal"
      class="mx-auto w-full max-w-[90rem] px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-10"
    >
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-[90rem] px-4 pb-8 sm:px-6 lg:px-10">
      <div class="flex flex-col gap-2 border-t border-line pt-5 text-xs leading-relaxed text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>CampusConnect+ · Prototipo académico para Duoc UC</p>
        <p>Los datos son de demostración y se guardan en este navegador.</p>
      </div>
    </footer>
  </div>
</Layout>
