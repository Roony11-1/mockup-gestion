---
import Layout from './Layout.astro';
import { AppNav } from '../components/layout/AppNav';

interface Props {
  title: string;
  description?: string;
  currentPath: string;
}

const { title, description, currentPath } = Astro.props;
---
<Layout title={title} description={description}>
  <a
    href="#contenido-principal"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-900 focus:shadow-lg"
  >
    Saltar al contenido principal
  </a>

  <AppNav client:load currentPath={currentPath} />

  <div class="lg:pl-72">
    <main
      id="contenido-principal"
      class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8"
    >
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="border-t border-slate-200 pt-5 text-xs leading-relaxed text-slate-400">
        <p>CampusConnect+ · Prototipo académico para Duoc UC · Los datos son de demostración.</p>
      </div>
    </footer>
  </div>
</Layout>
