---
// Reseñas de compañeros — solo se inyecta en DOM para rol student.
---
<div id="student-reviews-panel">
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-base font-bold">Reseñas de compañeros</h2>
      <span class="rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800">Solo estudiantes</span>
    </div>
    <p class="mb-3 text-xs text-slate-500">Referencias sobre cómo es trabajar con él/ella en proyectos grupales.</p>
    <div id="student-reviews-list" class="grid gap-2"></div>
    <form id="student-review-form" class="mt-3 grid gap-2 border-t border-slate-100 pt-3">
      <input name="student" required maxlength="60" placeholder="Nombre compañero/a (ej: Javiera Paredes)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      <div class="flex gap-2">
        <select name="rating" required class="w-24 shrink-0 rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <option value="">★ Nota</option>
          <option value="5">5 ★</option>
          <option value="4">4 ★</option>
          <option value="3">3 ★</option>
          <option value="2">2 ★</option>
          <option value="1">1 ★</option>
        </select>
        <input name="comment" required maxlength="280" placeholder="¿Cómo es trabajar con él/ella?" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <button class="rounded-lg bg-sky-700 py-2 text-sm font-semibold text-white hover:bg-sky-800">Agregar reseña compañero</button>
    </form>
  </div>
</div>
