---
// Reseñas de profesores — solo se inyecta en DOM para rol student.
---
<div id="teacher-reviews-panel">
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-base font-bold">Reseñas de profesores</h2>
      <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[11px] font-semibold text-violet-800">Solo estudiantes</span>
    </div>
    <p class="mb-3 text-xs text-slate-500">Registra y consulta cómo lleva cada docente su curso.</p>
    <div id="teacher-reviews-list" class="grid gap-2"></div>
    <form id="teacher-review-form" class="mt-3 grid gap-2 border-t border-slate-100 pt-3">
      <input name="teacher" required maxlength="60" placeholder="Nombre docente (ej: María González)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      <div class="flex gap-2">
        <select name="rating" required class="w-24 shrink-0 rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <option value="">★ Nota</option>
          <option value="5">5 ★</option>
          <option value="4">4 ★</option>
          <option value="3">3 ★</option>
          <option value="2">2 ★</option>
          <option value="1">1 ★</option>
        </select>
        <input name="comment" required maxlength="280" placeholder="Comentario académico" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <button class="rounded-lg bg-violet-700 py-2 text-sm font-semibold text-white hover:bg-violet-800">Agregar reseña docente</button>
    </form>
  </div>
</div>
