---
// Navegación adaptable al rol actual. El email/rol se rellenan por JS desde sessionStorage.
---
<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3">
    <div class="flex items-center gap-2">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-700 font-bold text-white">C+</div>
      <div>
        <p class="text-sm font-bold leading-tight">CampusConnect+</p>
        <p class="text-xs leading-tight text-slate-500">Duoc UC · Mockup</p>
      </div>
    </div>
    <div class="flex items-center gap-2 text-sm">
      <span id="navbar-role" class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">Sin sesión</span>
      <span id="navbar-email" class="hidden text-xs text-slate-500 sm:inline"></span>
      <button
        id="logout-btn"
        type="button"
        class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold hover:bg-slate-50"
      >
        Salir
      </button>
    </div>
  </div>
</header>

<script>
  import { SESSION_KEY } from '../lib/mockData.js';

  function paintNavbar() {
    try {
      const raw = sessionStorage.getItem(SESSION_KEY);
      if (!raw) return;
      const s = JSON.parse(raw);
      const roleEl = document.getElementById('navbar-role');
      const emailEl = document.getElementById('navbar-email');
      if (roleEl) {
        const labels = { student: 'Estudiante', staff: 'Personal Aseo', teacher: 'Docente' };
        roleEl.textContent = labels[s.role] ?? s.role;
        roleEl.className =
          'rounded-full px-3 py-1 text-xs font-semibold ' +
          (s.role === 'student'
            ? 'bg-blue-100 text-blue-800'
            : s.role === 'staff'
              ? 'bg-emerald-100 text-emerald-800'
              : 'bg-amber-100 text-amber-800');
      }
      if (emailEl && s.email) emailEl.textContent = s.email;
    } catch {}
  }

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    try {
      sessionStorage.removeItem(SESSION_KEY);
    } catch {}
    window.location.href = '/';
  });

  paintNavbar();
</script>
