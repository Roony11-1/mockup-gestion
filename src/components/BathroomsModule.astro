---
// Módulo de Baños: render por rol (dashboard.astro gestiona lógica).
interface Props {
  variant?: 'cards-student' | 'cards-staff' | 'table-staff' | 'cards-teacher';
  title?: string;
  description?: string;
}
const { variant = 'cards-student', title = 'Baños de la sede', description = '' } = Astro.props;
---
<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
  <div class="mb-3">
    <h2 class="text-base font-bold">{title}</h2>
    {description && <p class="mt-1 text-xs text-slate-500">{description}</p>}
    <div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
      <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-semibold text-emerald-800">Disponible</span>
      <span class="rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-800">En limpieza</span>
      <span class="rounded-full bg-red-100 px-2 py-0.5 font-semibold text-red-800">Cerrado por mantenimiento</span>
    </div>
  </div>

  {/* Staff: tabla en desktop (>=sm) */}
  {variant === 'table-staff' && (
    <>
      <div class="hidden sm:overflow-x-auto">
        <table class="w-full min-w-[520px] text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
              <th class="py-2 pr-2">Ubicación</th>
              <th class="py-2 pr-2">Horario aseo</th>
              <th class="py-2 pr-2">Estado</th>
              <th class="py-2">Cambiar estado</th>
            </tr>
          </thead>
          <tbody id="bathrooms-staff-tbody">
            <tr><td colspan="4" class="py-6 text-center text-slate-400">Cargando…</td></tr>
          </tbody>
        </table>
      </div>
      {/* Staff: cards en móvil (<sm) */}
      <div id="bathrooms-staff-cards" class="grid gap-2 sm:hidden">
        <p class="py-4 text-center text-sm text-slate-400">Cargando…</p>
      </div>
    </>
  )}

  {variant === 'cards-student' && (
    <div id="bathrooms-student-list" class="grid gap-2">
      <p class="py-4 text-center text-sm text-slate-400">Cargando…</p>
    </div>
  )}

  {variant === 'cards-teacher' && (
    <div id="bathrooms-teacher-list" class="grid gap-2">
      <p class="py-4 text-center text-sm text-slate-400">Cargando…</p>
    </div>
  )}
</section>
